    {
      "name": "PF-146 | Verify Project Info (TPO) API Test",
      "item": [
        {
          "name": "Get Project by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project retrieved successfully', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Project ID matches request', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.projectId).to.eql(pm.collectionVariables.get('projectId'));",
                  "});",
                  "",
                  "pm.test('TPO company name is correct', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.tpoInfo.companyName).to.eql('Premier Mortgage Partners');",
                  "});",
                  "",
                  "pm.test('TPO contact name is correct', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.tpoInfo.contactName).to.eql('Sarah Johnson');",
                  "});",
                  "",
                  "pm.test('TPO email is correct', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.tpoInfo.email).to.eql('sarah@premiermortgage.com');",
                  "});",
                  "",
                  "pm.test('TPO license number is correct', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.tpoInfo.licenseNumber).to.eql('NMLS-789456');",
                  "});",
                  "",
                  "pm.test('Project is linked to correct loan', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.loanId).to.eql(pm.collectionVariables.get('loanId'));",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
