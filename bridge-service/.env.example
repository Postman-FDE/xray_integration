# Xray Cloud API (Jira > Apps > Xray > API Keys)
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# Inbound auth for mutating endpoints (POST /sync/*, /scheduler/start|stop).
# Without this set, those endpoints return 503. Generate with: openssl rand -hex 32
BRIDGE_TRIGGER_SECRET=
# Optional: previous secret kept valid during rotation. Remove once all callers
# have switched to the new BRIDGE_TRIGGER_SECRET.
# BRIDGE_TRIGGER_SECRET_PREVIOUS=

# Postman API (https://postman.co/settings/me/api-keys)
POSTMAN_API_URL=https://api.getpostman.com
PM_API_KEY=PMAK-xxxxxxxxxxxxxxxx
POSTMAN_WORKSPACE_IDS=your-workspace-ids(comma-separated)

# Only sync runs after this timestamp
SYNC_BASE_TIME=2026-03-26T17:00:00Z

# Scheduler (optional)
SYNC_ENABLED=false
# Every hour at minute 0
SYNC_CRON=0 * * * *

# PostgreSQL (used by docker-compose to create the database)
POSTGRES_USER=xray
POSTGRES_PASSWORD=xray
POSTGRES_DB=xray_bridge
DATABASE_URL=postgresql://xray:xray@localhost:5432/xray_bridge
