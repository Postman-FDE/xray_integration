        {
          "name": "Submit Project Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Project created successfully', function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Project ID is generated', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.projectId).to.match(/^PROJ-[A-Z0-9]+$/);",
                  "    pm.collectionVariables.set('projectId', response.projectId);",
                  "});",
                  "",
                  "pm.test('Project is linked to loan', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.loanId).to.eql(pm.collectionVariables.get('loanId'));",
                  "});",
                  "",
                  "pm.test('Project name is set correctly', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.name).to.eql('Residential Purchase - 123 Main St');",
                  "});",
                  "",
                  "pm.test('TPO info is stored', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.tpoInfo).to.be.an('object');",
                  "    pm.expect(response.tpoInfo.companyName).to.eql('Premier Mortgage Partners');",
                  "});",
                  "",
                  "pm.test('Created timestamp is set', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.createdAt).to.be.a('string');",
                  "});"
                ],
