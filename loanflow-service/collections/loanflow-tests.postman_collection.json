        {
          "name": "Verify - List Projects by Loan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Projects retrieved successfully', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains projects array', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.projects).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('At least one project exists for loan', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.count).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('Projects belong to the correct loan', function() {",
                  "    const response = pm.response.json();",
                  "    const loanId = pm.collectionVariables.get('loanId');",
                  "    response.projects.forEach(project => {",
                  "        pm.expect(project.loanId).to.eql(loanId);",
                  "    });",
