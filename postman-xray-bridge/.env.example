# ============================================================================
# POSTMAN-XRAY-BRIDGE Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Xray Cloud API Credentials (Required)
# ----------------------------------------------------------------------------
# Get these from: Jira → Apps → Xray → API Keys
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# Xray base URL (optional, defaults to Xray Cloud)
# XRAY_BASE_URL=https://xray.cloud.getxray.app

# ----------------------------------------------------------------------------
# Postman API Credentials (Required for auto-sync)
# ----------------------------------------------------------------------------
# Get your API key from: https://postman.co/settings/me/api-keys
POSTMAN_API_KEY=PMAK-xxxxxxxxxxxxxxxx

# Comma-separated list of workspace IDs to sync
# Find workspace ID in Postman URL: postman.co/workspace/{name}~{workspace-id}
POSTMAN_WORKSPACE_IDS=1f0df51a-8658-4ee8-a2a1-d2567dfa09a9

# Multiple workspaces example:
# POSTMAN_WORKSPACE_IDS=ws-id-1,ws-id-2,ws-id-3

# ----------------------------------------------------------------------------
# Sync Job Settings (Optional)
# ----------------------------------------------------------------------------
# Enable auto-sync scheduler on server startup
SYNC_ENABLED=false

# Cron expression for sync job (default: every hour at minute 0)
# Examples:
#   "0 * * * *"     = Every hour
#   "*/15 * * * *"  = Every 15 minutes
#   "0 */2 * * *"   = Every 2 hours
#   "0 9 * * *"     = Daily at 9 AM
SYNC_CRON=0 * * * *

# ----------------------------------------------------------------------------
# Server Settings (Optional)
# ----------------------------------------------------------------------------
PORT=4000

# URL of the mock server that has API to fetch all collection runs, and to get json type run results
POSTMAN_MOCK_URL = https://be57294f-23b9-486c-b932-bcaf691d852e.mock.pstmn.io
# ----------------------------------------------------------------------------
# Development/Testing Settings (Optional)
# ----------------------------------------------------------------------------
# Dry run mode - transforms data but does NOT push to Xray or update state
# Useful for testing the sync flow without creating actual test executions
DRY_RUN=false
