# ============================================================================
# POSTMAN-XRAY-BRIDGE Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Database Settings (Required)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# To run PostgreSQL in Docker:
#   docker run -d --name xray_bridge_postgres \
#     -e POSTGRES_USER=xray -e POSTGRES_PASSWORD=xray -e POSTGRES_DB=xray_bridge \
#     -p 5432:5432 postgres:16
DATABASE_URL=postgresql://xray:xray@localhost:5432/xray_bridge

# ----------------------------------------------------------------------------
# Xray Cloud API Credentials (Required)
# ----------------------------------------------------------------------------
# Get these from: Jira → Apps → Xray → API Keys
XRAY_CLIENT_ID=your-xray-client-id
XRAY_CLIENT_SECRET=your-xray-client-secret

# Xray base URL (optional, defaults to Xray Cloud)
# XRAY_BASE_URL=https://xray.cloud.getxray.app

# ----------------------------------------------------------------------------
# Postman API Credentials (Required for auto-sync)
# ----------------------------------------------------------------------------
# Get your API key from: https://postman.co/settings/me/api-keys
PM_API_KEY=PMAK-xxxxxxxxxxxxxxxx

# Comma-separated list of workspace IDs to sync
# Find workspace ID in Postman URL: postman.co/workspace/{name}~{workspace-id}
POSTMAN_WORKSPACE_IDS=1f0df51a-8658-4ee8-a2a1-d2567dfa09a9

# Multiple workspaces example:
# POSTMAN_WORKSPACE_IDS=ws-id-1,ws-id-2,ws-id-3

# ----------------------------------------------------------------------------
# Internal Monitor API (Required for real monitor sync)
# ----------------------------------------------------------------------------
# Base URL for newman-remote-api (internal Postman service)
MONITOR_API_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Sync Job Settings (Optional)
# ----------------------------------------------------------------------------
# Enable auto-sync scheduler on server startup
SYNC_ENABLED=false

# Base time for sync - only sync runs after this timestamp
# Prevents syncing thousands of historical runs on first sync
# Format: ISO 8601 timestamp (e.g., 2026-01-01T00:00:00Z)
SYNC_BASE_TIME=2026-01-01T00:00:00Z

# Cron expression for sync job (default: every hour at minute 0)
# Examples:
#   "0 * * * *"     = Every hour
#   "*/15 * * * *"  = Every 15 minutes
#   "0 */2 * * *"   = Every 2 hours
#   "0 9 * * *"     = Daily at 9 AM
SYNC_CRON=0 * * * *

# ----------------------------------------------------------------------------
# Server Settings (Optional)
# ----------------------------------------------------------------------------
PORT=4000

# URL of the mock server that has API to fetch all collection runs, and to get json type run results
POSTMAN_MOCK_URL=https://your-mock-id.mock.pstmn.io

# ----------------------------------------------------------------------------
# Jira API Credentials (Optional - for auto-creating test issues)
# ----------------------------------------------------------------------------
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_BASE_URL=https://your-instance.atlassian.net

# ----------------------------------------------------------------------------
# Development/Testing Settings (Optional)
# ----------------------------------------------------------------------------
# Dry run mode - pushes to Xray but does NOT update the database
# Useful for testing the Xray integration without persisting state
# (runs will be re-synced on next run since DB isn't updated)
DRY_RUN=false
