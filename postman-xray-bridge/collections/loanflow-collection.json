        "item": [
          {
            "name": "Setup - Create Loan",
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "03c1de45-f723-4165-8e90-ef4643235c03",
                  "exec": [
                    "pm.test('Loan created successfully', function() {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test('Loan has ACTIVE status', function() {",
                    "    const response = pm.response.json();",
                    "    pm.expect(response.status).to.eql('ACTIVE');",
                    "});",
                    "",
                    "pm.test('Loan ID is generated', function() {",
                    "    const response = pm.response.json();",
                    "    pm.expect(response.loanId).to.match(/^LOAN-[A-Z0-9]+$/);",
                    "    pm.collectionVariables.set('loanId', response.loanId);",
                    "});"
                  ],
                  "type": "text/javascript",
                  "packages": {},
                  "requests": {}
                }
              }
