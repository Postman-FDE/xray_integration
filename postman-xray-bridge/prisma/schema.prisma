// Prisma schema for postman-xray-bridge
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tracks the last synced run per collection
model SyncState {
  collectionUid    String    @id @map("collection_uid")
  collectionName   String?   @map("collection_name")
  testPlanKey      String?   @map("test_plan_key")
  lastRunId        String?   @map("last_run_id")
  lastRunTimestamp DateTime? @map("last_run_timestamp")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("sync_state")
}

// Tracks each sync job execution
model SyncJob {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  status      String    @default("running") // running, success, partial, failed
  runsTotal   Int       @default(0) @map("runs_total")
  runsSuccess Int       @default(0) @map("runs_success")
  runsFailed  Int       @default(0) @map("runs_failed")

  runs SyncRun[]

  @@map("sync_jobs")
}

// Tracks individual runs synced within a job
model SyncRun {
  id            Int      @id @default(autoincrement())
  jobId         Int      @map("job_id")
  collectionUid String   @map("collection_uid")
  runId         String   @map("run_id")
  xrayExecKey   String?  @map("xray_exec_key")
  status        String   // success, error
  errorMessage  String?  @map("error_message")
  syncedAt      DateTime @default(now()) @map("synced_at")

  job SyncJob @relation(fields: [jobId], references: [id])

  @@map("sync_runs")
}
