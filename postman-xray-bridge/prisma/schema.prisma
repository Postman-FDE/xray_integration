// Prisma schema for postman-xray-bridge
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tracks the last synced run per source (monitor or collection)
model SyncState {
  sourceId         String    @map("source_id")        // Monitor ID or Collection UID
  sourceType       String    @map("source_type")      // 'monitor' | 'collection_run'
  sourceName       String?   @map("source_name")      // Monitor name or Collection name
  testPlanKey      String?   @map("test_plan_key")
  lastRunId        String?   @map("last_run_id")
  lastRunTimestamp DateTime? @map("last_run_timestamp")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@id([sourceId, sourceType])
  @@map("sync_state")
}

// Tracks each sync job execution
model SyncJob {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  status      String    @default("running") // running, success, partial, failed
  runsTotal   Int       @default(0) @map("runs_total")
  runsSuccess Int       @default(0) @map("runs_success")
  runsFailed  Int       @default(0) @map("runs_failed")

  runs SyncRun[]

  @@map("sync_jobs")
}

// Tracks individual runs synced within a job
model SyncRun {
  id           Int      @id @default(autoincrement())
  jobId        Int      @map("job_id")
  sourceId     String   @map("source_id")      // Monitor ID or Collection UID
  sourceType   String   @map("source_type")    // 'monitor' | 'collection_run'
  runId        String   @map("run_id")
  xrayExecKey  String?  @map("xray_exec_key")
  status       String   // success, error
  errorMessage String?  @map("error_message")
  syncedAt     DateTime @default(now()) @map("synced_at")

  job SyncJob @relation(fields: [jobId], references: [id])

  @@map("sync_runs")
}
