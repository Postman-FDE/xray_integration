# Copy this file to .env and fill in your credentials

# Xray Cloud API Credentials
# Get these from: Jira → Apps → Xray → API Keys
XRAY_CLIENT_ID=your_xray_client_id_here
XRAY_CLIENT_SECRET=your_xray_client_secret_here

# Jira API Token (optional - only needed for creating issues via Jira API)
# Get from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email@postman.com

# Optional Configuration
# XRAY_BASE_URL=https://xray.cloud.getxray.app
# PORT=4000

